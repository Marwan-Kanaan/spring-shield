<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.marwan-kanaan</groupId>
    <artifactId>spring-shield-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SpringShield</name>
    <description>
        An opinionated, secure-by-default Spring Boot starter that orchestrates Spring Security.
        SpringShield is a developer-experience layer on top of Spring Security, not a replacement
        for it.
    </description>
    <url>https://github.com/Marwan-Kanaan/spring-shield</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Marwan-Kanaan</id>
            <name>Marwan Kanaan</name>
            <url>https://github.com/Marwan-Kanaan</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Marwan-Kanaan/spring-shield.git</connection>
        <developerConnection>scm:git:git@github.com:Marwan-Kanaan/spring-shield.git</developerConnection>
        <url>https://github.com/Marwan-Kanaan/spring-shield</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Marwan-Kanaan/spring-shield/issues</url>
    </issueManagement>

    <!--
        Module layering. Each module may depend only on modules listed above it:

            spring-shield-core                 public abstractions, no Spring Boot coupling
            spring-shield-autoconfigure        Spring Boot integration and default wiring
            spring-shield-test                 test helpers for applications, test scope
            spring-shield-spring-boot-starter  dependency aggregator, no logic
    -->
    <modules>
        <module>spring-shield-core</module>
        <module>spring-shield-autoconfigure</module>
        <module>spring-shield-test</module>
        <module>spring-shield-spring-boot-starter</module>
    </modules>

    <properties>
        <!--
            Java 21 is the project baseline. Spring Boot 4.1's own parent defaults to
            java.version 17, so this is a deliberate raise, not an inherited value.
            maven.compiler.release (rather than source/target) makes the compiler
            validate against the Java 21 API surface.
        -->
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
            Single source of truth for the framework baseline. Spring Security, Spring
            Framework, JUnit, AssertJ and Testcontainers versions are intentionally NOT
            declared here: they are managed transitively by spring-boot-dependencies so
            that the whole stack stays internally consistent.

            Spring Boot 4.1.0 currently manages Spring Security 7.1.0.
        -->
        <spring-boot.version>4.1.0</spring-boot.version>

        <!--
            Plugin versions. spring-boot-dependencies pins these in <pluginManagement>,
            but a BOM <scope>import</scope> only contributes <dependencyManagement>, so
            they must be repeated here. The values match the ones Spring Boot 4.1.0 is
            built and tested with.
        -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>

        <!-- Quality gates. -->
        <spring-javaformat.version>0.0.48</spring-javaformat.version>
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
        <findsecbugs-plugin.version>1.14.0</findsecbugs-plugin.version>

        <!--
            Fixed timestamp for reproducible builds: without it, jar entry timestamps
            change on every build and two builds of the same commit produce different
            bytes. Consumers of a security library should be able to verify that a
            published jar was built from the tagged source.
        -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Importing the BOM rather than inheriting from spring-boot-starter-parent.
                SpringShield is a library, not an application: inheriting the starter parent
                would drag in application concerns such as the repackaging plugin and
                resource filtering that a published library must not carry.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules, so downstream POMs never repeat a version. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>spring-shield-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>spring-shield-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>spring-shield-test</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <!--
                        -parameters keeps constructor and method parameter names in the
                        bytecode. Spring uses them for constructor injection and for
                        @ConfigurationProperties binding, so this is required, not cosmetic.
                    -->
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>

            <!--
                Enforces the Spring Framework code style, the same formatter Spring Boot
                and Spring Security use. Chosen over a general-purpose formatter because
                contributors to a Spring ecosystem library already know this style, and it
                keeps diffs free of formatting noise.

                `mvn spring-javaformat:apply` reformats sources in place. The build only
                validates, so it never rewrites files behind your back.
            -->
            <plugin>
                <groupId>io.spring.javaformat</groupId>
                <artifactId>spring-javaformat-maven-plugin</artifactId>
                <version>${spring-javaformat.version}</version>
                <executions>
                    <execution>
                        <id>validate-format</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                SpotBugs with the Find Security Bugs plugin.

                Find Security Bugs is the reason this is here: it detects injection,
                weak cryptography, unsafe deserialization and hard-coded credential
                patterns that ordinary style checking cannot see. For a library whose
                whole purpose is security, this gate is worth its build cost.

                threshold=Low with effort=Max reports everything, including low-confidence
                findings. That is deliberate for a security library. Suppressions must be
                added to spotbugs-exclude.xml with a comment, so every ignored finding is
                a reviewable decision rather than a silent one.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <includeTests>false</includeTests>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Fail the build early when the local toolchain cannot honour the baseline,
                instead of failing later with a confusing compiler or bytecode error.
                Note that Maven runs on the JDK from JAVA_HOME, which may differ from the
                `java` binary first on PATH.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>SpringShield requires JDK 21 or later. Check JAVA_HOME.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <!--
                                    A security library must know exactly which version of
                                    each dependency it ships against. Convergence failures
                                    mean the resolved version depends on declaration order,
                                    which can silently pull in an unpatched transitive
                                    dependency.
                                -->
                                <dependencyConvergence/>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Source and Javadoc jars are required by Maven Central but are slow and noisy
            during day-to-day development, so they are bound to a release profile rather
            than the default build.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
