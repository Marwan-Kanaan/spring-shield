<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marwan-kanaan</groupId>
        <artifactId>spring-shield-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>spring-shield-autoconfigure</artifactId>
    <packaging>jar</packaging>

    <name>SpringShield Auto-Configuration</name>
    <description>
        Spring Boot auto-configuration for SpringShield: configuration properties,
        conditional wiring and the default Spring Security integration.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.marwan-kanaan</groupId>
            <artifactId>spring-shield-core</artifactId>
        </dependency>

        <!-- @AutoConfiguration and the @ConditionalOn* family. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            Spring Boot 4 split security auto-configuration out of spring-boot-autoconfigure
            into its own module, under the package org.springframework.boot.security.autoconfigure.
            SpringShield needs it to order its own auto-configuration relative to Boot's and to
            reuse SecurityProperties.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security</artifactId>
        </dependency>

        <!--
            Needed to compile the AuthenticationEntryPoint and AccessDeniedHandler, which
            take HttpServletRequest and HttpServletResponse. spring-security-web declares
            this as provided, and provided scope is not transitive, so it has to be
            repeated here.

            provided rather than compile: the servlet container supplies it at runtime, and
            a library that shipped its own copy could conflict with the container's.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Generates META-INF/spring-configuration-metadata.json so that springshield.*
            properties get IDE completion and documentation.
            optional=true keeps the processor off the consumer's compile classpath.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Servlet and MVC support, test scope only. The security filter chain can only be
            proven by issuing real requests through it: an assertion that a bean exists says
            nothing about whether an unauthenticated request is actually rejected.
            Test scope keeps this out of the published dependency graph.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            MockMvc test support. Spring Boot 4 moved it out of spring-boot-test-autoconfigure
            into this separate module, under the package
            org.springframework.boot.webmvc.test.autoconfigure, and spring-boot-starter-test
            does not pull it in, so it has to be declared explicitly.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Applies Spring Security's springSecurity() configurer to the auto-configured
            MockMvc. Without it @WithMockUser has no effect on a MockMvc request and every
            authenticated test would fail with 401, which looks like a broken filter chain
            rather than missing test wiring.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
