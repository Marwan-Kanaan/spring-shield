<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marwan-kanaan</groupId>
        <artifactId>spring-shield-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>spring-shield-core</artifactId>
    <packaging>jar</packaging>

    <name>SpringShield Core</name>
    <description>
        Stable public abstractions for SpringShield: security value objects, application
        extension interfaces and authorization annotations.
    </description>

    <!--
        Core holds the types application code implements and depends on, so every dependency
        added here becomes a dependency of every SpringShield user. Keep this list short.

        Spring Boot, JPA and JDBC coupling does not belong here; it belongs in
        spring-shield-autoconfigure or in a dedicated adapter module. Adding a compile
        dependency to this module is an architectural decision that needs an explicit
        justification in the change description.
    -->
    <dependencies>
        <!--
            Required so @RequiresPermission and @RequiresRole can be meta-annotated with
            Spring Security's @PreAuthorize. That makes them genuine Spring Security
            annotations, enforced by Spring Security's own method authorization, instead of
            markers SpringShield would have to interpret with authorization code of its own.

            Deliberately only spring-security-core, which is the annotation and
            Authentication model. It pulls in no web, servlet or Spring Boot coupling, so the
            value objects here stay usable from plain domain code.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
