<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs / Find Security Bugs suppressions.

    Every entry here silences a finding, so every entry needs a comment explaining why
    the finding does not apply. "It was noisy" is not a reason. Prefer fixing the code,
    or narrowing the suppression to a single class and bug pattern, over broad excludes.

    Suppressing a security finding (any pattern from Find Security Bugs) should be treated
    as a security decision and reviewed as one.

    Format reference: https://spotbugs.readthedocs.io/en/stable/filter.html
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- No suppressions yet. Add them below with a justification comment. -->

</FindBugsFilter>
