<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marwan-kanaan</groupId>
        <artifactId>spring-shield-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>spring-shield-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>SpringShield Spring Boot Starter</name>
    <description>
        The dependency users add. Brings in SpringShield and the Spring Security pieces
        needed for the standard experience.
    </description>

    <!--
        Dependency aggregator only. This module must never contain Java sources.

        Optional integrations - JPA, JDBC, OAuth2/OIDC SSO - are deliberately absent.
        They belong in their own starters so applications that do not use them do not
        inherit their dependencies.
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.marwan-kanaan</groupId>
            <artifactId>spring-shield-autoconfigure</artifactId>
        </dependency>

        <!--
            Brings spring-boot-security plus Spring Security itself. SpringShield
            configures Spring Security rather than replacing it, so the starter always
            pulls it in.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
    </dependencies>

</project>
