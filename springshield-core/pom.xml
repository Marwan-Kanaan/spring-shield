<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mkanaan</groupId>
        <artifactId>springshield-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>springshield-core</artifactId>
    <packaging>jar</packaging>

    <name>SpringShield Core</name>
    <description>
        Stable public abstractions for SpringShield: security value objects, application
        extension interfaces and authorization annotations.
    </description>

    <!--
        This module deliberately has no compile-scope dependencies.

        Core holds the types application code is expected to implement and depend on, so
        every dependency added here becomes a dependency of every SpringShield user. Spring
        Boot, Spring Security, JPA and JDBC coupling belongs in springshield-autoconfigure
        or in a dedicated adapter module.

        Adding a compile dependency to this module is an architectural decision that needs
        an explicit justification in the change description.
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
